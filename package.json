    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.1",
    "@capacitor/status-bar": "^6.0.1",
    "@capacitor/toast": "^6.0.4",
    "@capgo/capacitor-native-biometric": "^6.0.4",
    "@google/genai": "^1.38.0",
    "@types/react-router-dom": "^5.3.3",
    "firebase": "^11.0.1",
    "lucide-react": "^0.468.0",
